{
  "name": "projeto2",
  "version": "0.1.0",
  "private": true,
  "description": "Aplicação web front-end para pesquisar cidades, consultar as condições meteorológicas atuais e visualizar a previsão dos próximos cinco dias. Os dados devem ser obtidos da API pública **Open-Meteo**, e o usuário deve poder manter uma lista persistente de cidades favoritas usando `localStorage`.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "react",
    "typescript",
    "open-meteo"
  ],
  "type": "module",
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
